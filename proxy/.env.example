# Copy to .env and fill in. These live ONLY here (server-side), never in the app.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase JWT secret — Settings → API → JWT Secret. REQUIRED: /coach fails closed (503)
# without it, and rejects any request whose Bearer token isn't a valid, unexpired session (401).
SUPABASE_JWT_SECRET=

PORT=8787
COACH_MODEL=claude-opus-4-8
