{
  "$meta": {
    "name": "Yap Design Tokens",
    "source": "yap-design-doc.md v1.0 (2026-07-22)",
    "concept": "Purple is the stage. Gold is the reward.",
    "note": "Every value taken verbatim from the design doc. No invented values."
  },
  "color": {
    "purple": {
      "studio-ink":    { "value": "#180530", "use": "Deepest background base, app background" },
      "studio-grape":  { "value": "#2C0A56", "use": "Cards / raised surfaces on dark" },
      "studio-royal":  { "value": "#4A159C", "use": "Secondary surfaces, pressed states" },
      "studio-violet": { "value": "#7C2BE0", "use": "Primary brand — buttons, active states, brand fills" },
      "studio-orchid": { "value": "#A64BF4", "use": "Spotlight center, highlights, focus glow" },
      "studio-lilac":  { "value": "#C9A6F0", "use": "Muted text on dark, inactive icons, hairlines" }
    },
    "gold": {
      "foil-amber": { "value": "#E8A317", "use": "Deep edge of gold gradient, gold button bottom-edge" },
      "foil-gold":  { "value": "#F6C324", "use": "Reward primary — streak, score-up, primary gold CTA" },
      "foil-sun":   { "value": "#FFE07A", "use": "Light end of gold gradient, shimmer" },
      "foil-glow":  { "value": "#FFF1A8", "use": "Confetti, sparkle, premium sheen" }
    },
    "functional": {
      "text-white":   { "value": "#FFFFFF", "use": "Bold headlines & numbers on purple" },
      "text-soft":    { "value": "#F1E9FF", "use": "Body copy on dark (lilac-tinted white)" },
      "text-mute":    { "value": "#B79ED6", "use": "Captions, secondary labels" },
      "signal-coral": { "value": "#FF5C7A", "use": "Only destructive / negative-delta (never decorative)" },
      "signal-mint":  { "value": "#3CE0B0", "use": "Only 'you improved' up-arrows (used sparingly)" }
    }
  },
  "gradient": {
    "grad-spotlight": {
      "value": "radial-gradient(circle at 50% 40%, #A64BF4 0%, #7C2BE0 34%, #3B0F73 72%, #180530 100%)",
      "use": "Studio spotlight — signature. Record screen, win screens, hero moments"
    },
    "grad-violet": {
      "value": "linear-gradient(180deg, #8E2FE6 0%, #5A1BB0 100%)",
      "use": "Purple surface — buttons, chunky cards"
    },
    "grad-foil": {
      "value": "linear-gradient(135deg, #FFE07A 0%, #F6C324 46%, #E8A317 100%)",
      "use": "Gold foil — reward CTAs, streak, Pro. Warm, metallic"
    },
    "grad-sheen": {
      "value": "linear-gradient(105deg, transparent 32%, rgba(255,255,255,.55) 48%, transparent 62%)",
      "use": "Foil sheen — animated shimmer swept across gold on wins/Pro"
    }
  },
  "elevation": {
    "shadow-card": { "value": "0 8px 24px rgba(24,5,48,.45)", "use": "Raised card on dark" },
    "glow-focus":  { "value": "0 0 0 4px rgba(166,75,244,.45)", "use": "Orchid focus ring" },
    "glow-gold":   { "value": "0 8px 20px rgba(246,195,36,.35)", "use": "Glow under gold CTAs" }
  },
  "radius": {
    "sm":   { "value": "12px" },
    "md":   { "value": "16px" },
    "lg":   { "value": "24px" },
    "xl":   { "value": "32px" },
    "pill": { "value": "999px" }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "7": "32px", "8": "40px", "9": "48px", "10": "56px", "11": "64px",
    "$note": "4-base scale. Screen gutters = 20. Card padding = 20–24."
  },
  "font": {
    "display": { "family": "Fraunces", "role": "Display / brand — headings and all numbers", "weights": [600, 700, 900], "axes": "opsz, wght, SOFT (up slightly), WONK (low)" },
    "ui":      { "family": "Nunito", "role": "UI / body — body, labels, buttons, inputs", "weights": [600, 800] }
  },
  "typeScale": {
    "score":   { "font": "Fraunces", "weight": 900, "size": 88, "leading": 0.95, "notes": "Counts up on reveal" },
    "hero":    { "font": "Fraunces", "weight": 900, "size": 40, "leading": 1.05, "notes": "White on purple" },
    "title":   { "font": "Fraunces", "weight": 700, "size": 26, "leading": 1.1 },
    "subhead": { "font": "Fraunces", "weight": 600, "size": 20, "leading": 1.2 },
    "body-l":  { "font": "Nunito", "weight": 600, "size": 17, "leading": 1.5 },
    "body":    { "font": "Nunito", "weight": 600, "size": 15, "leading": 1.5, "color": "text-soft" },
    "button":  { "font": "Nunito", "weight": 800, "size": 17, "leading": 1.0, "notes": "Sentence case" },
    "eyebrow": { "font": "Nunito", "weight": 800, "size": 12, "leading": 1.0, "tracking": "+8%", "transform": "UPPERCASE", "color": "text-mute or gold" },
    "caption": { "font": "Nunito", "weight": 600, "size": 12, "leading": 1.3, "color": "text-mute" }
  },
  "motion": {
    "spotlight-bloom": { "duration": "500ms", "desc": "Radial spotlight scales 0.9→1 + brightens. 'Lights come up.'" },
    "candy-press":     { "duration": "90ms",  "desc": "translateY(+4px), bottom edge shrinks 6px→2px" },
    "score-countup":   { "duration": "900ms", "ease": "ease-out", "desc": "Number ticks 0→final; ring fills in sync" },
    "win-confetti":    { "desc": "Gold-foil confetti burst + sheen sweep; milestones only" },
    "streak-flicker":  { "duration": "2500ms", "desc": "Subtle flame flicker loop (2–3s)" }
  }
}
